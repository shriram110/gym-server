# Database — Postgres connection string
# Local example (SQLite fallback also supported via sqlite:///./gym.db):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gym

# JWT
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS — comma-separated origins of your frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
